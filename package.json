{
  "name": "oraculum",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "protocol": "node scripts/generate-protocol.mjs",
    "check": "tsc --noEmit && pnpm check:desktop",
    "test": "vitest run gateway packages apps/desktop/src scripts",
    "desktop": "pnpm build:desktop && pnpm --filter @oraculum/desktop start",
    "build:desktop": "pnpm --filter @oraculum/desktop build",
    "check:desktop": "pnpm --filter @oraculum/desktop check",
    "test:desktop": "vitest run apps/desktop/src",
    "test:desktop:gui": "tsx scripts/desktop-p43-fixtures.ts",
    "gateway": "tsx gateway/src/main.ts",
    "gateway:cli": "tsx gateway/src/cli.ts",
    "gateway:protocol": "node scripts/generate-gateway-protocol.mjs",
    "test:gateway": "vitest run gateway packages/gateway-protocol",
    "test:gateway:live": "tsx scripts/gateway-live.ts",
    "verify:gateway:protocol": "node scripts/verify-gateway-protocol.mjs",
    "test:gateway:faults": "tsx scripts/gateway-faults.ts",
    "build:gateway:runtime": "node scripts/build-gateway-runtime.mjs",
    "build:gateway:deb": "pnpm build:gateway:runtime && node scripts/build-gateway-deb.mjs",
    "verify:gateway:deb": "node scripts/verify-gateway-deb.mjs",
    "test:gateway:packaging": "vitest run scripts/build-gateway.test.mjs",
    "build": "pnpm build:desktop && pnpm build:gateway:runtime",
    "build:desktop:deb": "node -e \"console.error('Desktop DEB packaging is unavailable: the retired 0.2.0 pipeline was removed in P4.3.5. P4.4 must implement and approve the new independent Desktop packaging. Use pnpm build:desktop for a bundle only.'); process.exit(1)\"",
    "verify:desktop:deb": "node -e \"console.error('Desktop DEB packaging is unavailable: the retired 0.2.0 pipeline was removed in P4.3.5. P4.4 must implement and approve the new independent Desktop packaging. Use pnpm build:desktop for a bundle only.'); process.exit(1)\""
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "quicktype-core": "24.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "ws": "8.22.0"
  }
}
