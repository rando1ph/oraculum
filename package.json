{
  "name": "oraculum",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "protocol": "node scripts/generate-protocol.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "bridge": "tsx bridge/src/main.ts",
    "trust": "tsx bridge/src/trust.ts",
    "test:live": "tsx scripts/live-smoke.ts",
    "build": "pnpm --filter @oraculum/web build",
    "desktop": "pnpm --filter @oraculum/desktop start",
    "test:ui": "tsx scripts/ui-smoke.ts",
    "test:ui:mock": "tsx scripts/ui-contract.ts",
    "test:phase1": "tsx scripts/phase1-live.ts",
    "test:android": "tsx scripts/android-live.ts",
    "test:auth:ui": "tsx scripts/auth-ui.ts",
    "test:auth:android": "tsx scripts/android-auth.ts",
    "test:recovery:local": "tsx scripts/recovery-local.ts",
    "test:history": "tsx scripts/history-probe.ts",
    "test:phase3:desktop": "tsx scripts/phase3-desktop.ts",
    "test:phase3:ui": "tsx scripts/phase3-ui-contract.ts",
    "test:phase3:review": "tsx scripts/phase3-desktop-review.ts",
    "test:phase3:mobile": "tsx scripts/phase3-mobile-contract.ts",
    "test:phase3:android": "tsx scripts/phase3-android.ts",
    "test:themes:ui": "tsx scripts/themes-ui-contract.ts",
    "test:themes:live": "tsx scripts/themes-live.ts",
    "test:native:config": "tsx scripts/native-config.ts",
    "test:permissions:native": "tsx scripts/permissions-native.ts",
    "test:permissions:ui": "tsx scripts/permissions-ui.ts",
    "test:lifecycle:live": "tsx scripts/lifecycle-live.ts",
    "test:lifecycle:android": "tsx scripts/lifecycle-live.ts --android",
    "test:lifecycle:ui": "tsx scripts/lifecycle-ui-contract.ts",
    "test:messages:ui": "tsx scripts/messages-ui-contract.ts",
    "test:messages:live": "tsx scripts/messages-live.ts",
    "test:native:elicitation": "tsx scripts/native-elicitation.ts",
    "test:native:capabilities": "tsx scripts/native-capabilities-live.ts",
    "test:native:ui": "tsx scripts/native-requests-ui.ts",
    "test:native:devices": "tsx scripts/native-requests-live.ts",
    "build:runtime": "pnpm build && node scripts/build-runtime.mjs",
    "build:deb": "pnpm build:runtime && node scripts/build-desktop.mjs",
    "test:composer:ui": "tsx scripts/composer-ui-contract.ts",
    "test:composer:live": "tsx scripts/composer-live.ts"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "ws": "8.22.0"
  }
}
