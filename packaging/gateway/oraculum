#!/bin/sh
set -eu
entry=$(readlink -f -- "$0")
runtime=$(CDPATH= cd -- "$(dirname -- "$entry")/.." && pwd -P)
# The portable JS WebSocket implementation has no optional native dependencies.
export WS_NO_BUFFER_UTIL=1 WS_NO_UTF_8_VALIDATE=1
exec "$runtime/node/bin/node" "$runtime/gateway/cli.mjs" "$@"
