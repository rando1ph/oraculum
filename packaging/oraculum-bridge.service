[Unit]
Description=Oraculum Bridge (official Codex App Server)
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/lib/oraculum-bridge/bin/oraculum-bridge
WorkingDirectory=%h
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=control-group
# Do not constrain native Codex tools or replace its own permissions/configuration.
# Package installation never starts/enables a service. Registration, legacy entry
# migration, start/enable and data selection are explicit deployment operations.

[Install]
WantedBy=default.target
